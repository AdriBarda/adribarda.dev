---
import type { SectionGroup } from '../../content/sections'
import SectionHead from './SectionHead.astro'

const { group, index = 0 } = Astro.props as { group?: SectionGroup; index?: number }
const experience = group?.entries.find((entry) => entry.data.section === 'experience')
const impact = group?.entries.find((entry) => entry.data.section === 'impact')
const timeline = experience?.data.items ?? []

function getPeriodYear(period?: string) {
	return period?.match(/\b\d{4}\b/g)?.at(-1)
}

const earliestYear = getPeriodYear(timeline.at(-1)?.period)
const latestYear = getPeriodYear(timeline[0]?.period)
const experienceMeta = [
	earliestYear && latestYear ? `${earliestYear}—${latestYear}` : undefined,
	timeline.length > 0 ? `${timeline.length} roles` : undefined
]
	.filter(Boolean)
	.join('  ·  ')
---

<div class="flex w-full flex-col gap-(--space-3xl)">
	<SectionHead title={experience?.data.title ?? 'Missing experience title.'} lead={experience?.data.summary} />

	<ol class="flex flex-col gap-(--space-3xl)">
		{timeline.length > 0 ? (
			timeline.map((item) => (
				<li
					data-role-row
					data-reveal
					class="grid gap-(--space-md) md:grid-cols-[minmax(0,13rem)_minmax(0,1fr)] md:gap-(--space-2xl)"
				>
					<div data-role-meta>
						<time data-meta class="block text-[length:var(--text-label)] uppercase text-app-muted">{item.period}</time>
						<p class="mt-2 text-[length:var(--text-sm)] leading-[1.5] font-medium text-app-text">{item.company}</p>
						{item.location && <p class="text-[length:var(--text-sm)] leading-[1.5] text-app-muted">{item.location}</p>}
					</div>

					<div class="max-w-(--measure)">
						<h3 class="text-[length:var(--text-h3)] leading-[1.15] font-semibold text-app-text">
							{item.role}
						</h3>
						<p class="mt-(--space-sm) text-[length:var(--text-body)] leading-[1.72] text-app-muted text-pretty">{item.description}</p>

						{item.highlights.length > 0 && (
							<ul class="mt-(--space-md) flex flex-col gap-2">
								{item.highlights.map((highlight) => (
									<li class="grid grid-cols-[auto_1fr] gap-3">
										<span class="mt-[0.6rem] size-1 shrink-0 rounded-full bg-app-muted/70"></span>
										<p class="text-[length:var(--text-sm)] leading-[1.68] text-app-muted text-pretty">{highlight}</p>
									</li>
								))}
							</ul>
						)}
					</div>
				</li>
			))
		) : (
			<li class="text-[length:var(--text-body)] text-app-muted">Missing experience timeline.</li>
		)}
	</ol>

	<div class="grid gap-(--space-lg) md:grid-cols-[minmax(0,13rem)_minmax(0,1fr)] md:gap-(--space-2xl)">
		<p data-label class="text-[length:var(--text-label)] uppercase text-app-muted">Impact</p>

		<div class="max-w-(--measure)">
			<p class="text-[length:var(--text-lead)] leading-[1.4] font-medium text-app-text text-pretty">
				{impact?.data.title ?? 'Missing impact title.'}
			</p>

			{impact?.data.highlights?.length ? (
				<ul class="mt-(--space-lg) flex flex-col gap-(--space-sm)">
					{impact.data.highlights.map((highlight) => (
						<li class="grid grid-cols-[auto_1fr] gap-3">
							<span class="mt-[0.6rem] size-1 shrink-0 rounded-full bg-app-muted/70"></span>
							<p class="text-[length:var(--text-body)] leading-[1.72] text-app-muted text-pretty">{highlight}</p>
						</li>
					))}
				</ul>
			) : null}
		</div>
	</div>
</div>

<script>
	import { gsap, ScrollTrigger, motionOK, refreshOnFonts } from '../../scripts/motion'

	const rows = document.querySelectorAll<HTMLElement>('[data-role-row]')
	const pinned = window.matchMedia('(min-width: 48rem)')

	if (rows.length > 0 && pinned.matches && motionOK()) {
		const REST = 0.32

		rows.forEach((row) => {
			const meta = row.querySelector<HTMLElement>('[data-role-meta]')
			if (!meta) return

			const setOpacity = gsap.quickSetter(meta, 'opacity') as (v: number) => void

			ScrollTrigger.create({
				trigger: row,
				start: 'bottom 55%',
				end: 'bottom 25%',
				scrub: true,
				invalidateOnRefresh: true,
				onUpdate: (self) => setOpacity(1 - self.progress * (1 - REST))
			})
		})

		refreshOnFonts()
	}
</script>
