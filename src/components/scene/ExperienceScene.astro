---
import type { SectionGroup } from '../../content/sections'
import SectionHead from './SectionHead.astro'

const { group, index = 0 } = Astro.props as { group?: SectionGroup; index?: number }
const experience = group?.entries.find((entry) => entry.data.section === 'experience')
const impact = group?.entries.find((entry) => entry.data.section === 'impact')
const timeline = experience?.data.items ?? []

const MONTHS = ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec']

/** A period endpoint ("May 2024") as an absolute month index, so a span can be measured. */
function toMonths(text?: string) {
	const value = text?.trim().toLowerCase() ?? ''
	const year = Number(value.match(/\d{4}/)?.[0])
	if (!year) return undefined
	const month = MONTHS.findIndex((name) => value.startsWith(name))
	return year * 12 + (month < 0 ? 0 : month)
}

const nowMonths = new Date().getFullYear() * 12 + new Date().getMonth()

function toDuration(period?: string) {
	const [from, to] = (period ?? '').split(/\s*[-–—]\s*/)
	const start = toMonths(from)
	const end = /present|now|current/i.test(to ?? '') ? nowMonths : toMonths(to)
	if (start === undefined || end === undefined || end < start) return undefined

	const months = end - start + 1
	const years = Math.floor(months / 12)
	const rest = months % 12
	return [years > 0 ? `${years} yr` : null, rest > 0 ? `${rest} mo` : null].filter(Boolean).join(' ') || '1 mo'
}

const rows = timeline.map((item, position) => ({
	item,
	tile: `--tile-${(position % 6) + 1}`,
	meta: [item.company, item.location, toDuration(item.period)].filter(Boolean).join('  ·  ')
}))
---

<div class="flex w-full flex-col gap-(--gap-section)">
	<SectionHead title={experience?.data.title ?? 'Missing experience title.'} lead={experience?.data.summary} />

	{rows.length > 0 ? (
		<ol class="timeline">
			{rows.map(({ item, tile, meta }) => (
				<li data-reveal class="timeline-row" style={`--marker: var(${tile});`}>
					<span class="timeline-marker" aria-hidden="true"></span>

					<div class="timeline-entry">
						<time data-meta class="text-[color:var(--marker)]">{item.period}</time>

						<h3 class="mt-(--space-xs) text-[length:var(--text-h3)] leading-[1.1] font-semibold text-app-text text-balance">
							{item.role}
						</h3>

						<p data-meta class="mt-(--space-2xs) text-app-muted">{meta}</p>

						<p class="mt-(--space-md) text-[length:var(--text-body)] leading-[1.72] text-app-text-2 text-pretty">
							{item.description}
						</p>

						{item.highlights.length > 0 && (
							<ul class="mt-(--space-md) flex flex-col gap-(--space-xs)">
								{item.highlights.map((highlight) => (
									<li class="grid grid-cols-[auto_1fr] gap-3">
										<span class="mt-[0.62rem] h-px w-3 shrink-0 bg-[color:var(--marker)]"></span>
										<p class="text-[length:var(--text-sm)] leading-[1.68] text-app-muted text-pretty">{highlight}</p>
									</li>
								))}
							</ul>
						)}
					</div>
				</li>
			))}
		</ol>
	) : (
		<p class="text-[length:var(--text-body)] text-app-muted">Missing experience timeline.</p>
	)}

	<div class="flex flex-col">
		<p data-label class="text-app-muted">Impact</p>

		<p class="mt-(--space-md) max-w-(--measure) text-[length:var(--text-lead)] leading-[1.4] font-medium text-app-text text-pretty">
			{impact?.data.title ?? 'Missing impact title.'}
		</p>

		{impact?.data.highlights?.length ? (
			<ul class="mt-(--space-xl) grid gap-(--space-md) md:grid-cols-2 md:gap-x-(--space-2xl)">
				{impact.data.highlights.map((highlight) => (
					<li class="grid grid-cols-[auto_1fr] gap-3">
						<span class="mt-[0.72rem] h-px w-3 shrink-0 bg-[color:var(--band)]"></span>
						<p class="text-[length:var(--text-body)] leading-[1.72] text-app-muted text-pretty">{highlight}</p>
					</li>
				))}
			</ul>
		) : null}
	</div>
</div>
