---
import type { SectionGroup } from '../../content/sections'
import SectionHead from './SectionHead.astro'
import astroIcon from '../../assets/tech-stack/astro.svg'
import vueIcon from '../../assets/tech-stack/vue.svg'
import vitestIcon from '../../assets/tech-stack/vitest.svg'
import viteIcon from '../../assets/tech-stack/vite.svg'
import typescriptIcon from '../../assets/tech-stack/typescript.svg'
import reactIcon from '../../assets/tech-stack/react.svg'
import playwrightIcon from '../../assets/tech-stack/playwright.svg'
import piniaIcon from '../../assets/tech-stack/pinia.svg'
import nodeIcon from '../../assets/tech-stack/node.svg'
import mysqlIcon from '../../assets/tech-stack/mysql.svg'
import javascriptIcon from '../../assets/tech-stack/javascript.svg'
import javaIcon from '../../assets/tech-stack/java.svg'
import expressIcon from '../../assets/tech-stack/express.svg'
import eslintIcon from '../../assets/tech-stack/eslint.svg'
import gitIcon from '../../assets/tech-stack/git.svg'
import postgresqlIcon from '../../assets/tech-stack/postgresql.svg'
import claudeCodeIcon from '../../assets/tech-stack/claude-code.svg'
import codexIcon from '../../assets/tech-stack/codex.svg'
import copilotIcon from '../../assets/tech-stack/copilot.svg'
import openCodeIcon from '../../assets/tech-stack/opencode.svg'

const { group, index = 0 } = Astro.props as { group?: SectionGroup; index?: number }
const stack = group?.entries.find((entry) => entry.data.section === 'stack')

type Level = 'Advanced' | 'Comfortable' | 'Familiar'
type Tech = { name: string; Icon: any; level: Level }

const stackGroups: Array<{ label: string; technologies: Tech[] }> = [
	{
		label: 'Frontend systems',
		technologies: [
			{ name: 'Vue', Icon: vueIcon, level: 'Advanced' },
			{ name: 'React', Icon: reactIcon, level: 'Comfortable' },
			{ name: 'TypeScript', Icon: typescriptIcon, level: 'Advanced' },
			{ name: 'JavaScript', Icon: javascriptIcon, level: 'Advanced' },
			{ name: 'Astro', Icon: astroIcon, level: 'Comfortable' },
			{ name: 'Pinia', Icon: piniaIcon, level: 'Advanced' },
			{ name: 'Vite', Icon: viteIcon, level: 'Comfortable' }
		]
	},
	{
		label: 'Quality and tooling',
		technologies: [
			{ name: 'Vitest', Icon: vitestIcon, level: 'Comfortable' },
			{ name: 'Playwright', Icon: playwrightIcon, level: 'Comfortable' },
			{ name: 'Git', Icon: gitIcon, level: 'Comfortable' },
			{ name: 'ESLint', Icon: eslintIcon, level: 'Comfortable' }
		]
	},
	{
		label: 'Backend and data',
		technologies: [
			{ name: 'Node.js', Icon: nodeIcon, level: 'Comfortable' },
			{ name: 'Express', Icon: expressIcon, level: 'Comfortable' },
			{ name: 'PostgreSQL', Icon: postgresqlIcon, level: 'Comfortable' },
			{ name: 'MySQL', Icon: mysqlIcon, level: 'Comfortable' },
			{ name: 'Java', Icon: javaIcon, level: 'Familiar' }
		]
	},
	{
		label: 'AI tools and agents',
		technologies: [
			{ name: 'Claude Code', Icon: claudeCodeIcon, level: 'Comfortable' },
			{ name: 'Codex', Icon: codexIcon, level: 'Comfortable' },
			{ name: 'Copilot', Icon: copilotIcon, level: 'Comfortable' },
			{ name: 'OpenCode', Icon: openCodeIcon, level: 'Comfortable' }
		]
	}
]

const filled = (level: Level) => (level === 'Advanced' ? 3 : level === 'Comfortable' ? 2 : 1)

const MONO_ICONS = new Set(['Astro', 'Codex', 'Copilot', 'Express'])

---

<div data-stack-scene class="flex w-full flex-col gap-(--space-3xl)">
	<div class="flex flex-col items-start gap-(--space-xl)">
		<SectionHead title={'Technologies I ship with.'} lead={stack?.data.summary && !stack.data.summary.toLowerCase().startsWith('lorem') ? stack.data.summary : 'The tools I reach for most, the ones I work with confidently in production, and the ones I can step into when a project calls for them.'} />

		<button data-gravity-toggle type="button" aria-pressed="true" hidden class="gravity-toggle">
			<span data-gravity-dot aria-hidden="true"></span>
			<span data-label>Gravity</span>
			<span data-gravity-state aria-hidden="true">on</span>
		</button>
	</div>

	<ul class="stack-grid">
		{stackGroups.map((stackGroup) => (
			<li class="stack-item">
				<div class="stack-card">
					<div class="stack-head">
						<h3 class="stack-title">{stackGroup.label}</h3>
						<p class="stack-count">{stackGroup.technologies.length} tools</p>
					</div>

					<ul class="grid grid-cols-[repeat(auto-fit,minmax(9rem,1fr))] gap-(--space-lg)">
						{stackGroup.technologies.map((technology) => (
							<li data-tool class="flex items-center gap-2.5">
								<technology.Icon aria-hidden="true" class:list={['size-7 shrink-0', MONO_ICONS.has(technology.name) && 'tech-icon-mono']} />
								<span class="min-w-0">
									<span class="block text-(length:--text-body) leading-tight font-medium text-(--stack-card-text)">
										{technology.name}
									</span>
									<span class="mt-1 flex gap-1" role="img" aria-label={`${technology.level} with ${technology.name}`}>
										{Array.from({ length: 3 }).map((_, i) => (
											<span
												class:list={[
													'block h-0.5 w-3 rounded-full',
													i < filled(technology.level)
														? 'bg-(--stack-caramel)'
														: 'bg-(--stack-card-line)'
												]}
											></span>
										))}
									</span>
								</span>
							</li>
						))}
					</ul>
				</div>
			</li>
		))}
	</ul>
</div>

<script>
	import { motionOK } from '../../scripts/motion'
	import { createPointerField } from '../../scripts/pointer-field'

	const scene = document.querySelector<HTMLElement>('[data-stack-scene]')
	const toggle = scene?.querySelector<HTMLButtonElement>('[data-gravity-toggle]')
	const state = toggle?.querySelector('[data-gravity-state]')
	const tools = [...(scene?.querySelectorAll<HTMLElement>('[data-tool]') ?? [])]

	// A pointer field needs a pointer: on a touch screen there is nothing to follow.
	const pointerOK = window.matchMedia('(hover: hover) and (pointer: fine)').matches

	if (scene && toggle && state && tools.length > 0 && motionOK() && pointerOK) {
		const field = createPointerField(scene, tools)

		toggle.hidden = false

		toggle.addEventListener('click', () => {
			const on = toggle.getAttribute('aria-pressed') !== 'true'

			toggle.setAttribute('aria-pressed', String(on))
			state.textContent = on ? 'on' : 'off'

			if (on) field.stop()
			else field.start()
		})
	}
</script>
