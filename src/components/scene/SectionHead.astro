---
interface Props {
	title: string
	lead?: string
}

const { title, lead } = Astro.props

// The section's colour lands on the heading's terminal punctuation, so it rides
// the type instead of sitting beside it.
const match = title.match(/^(.*?)([.!?])$/)
const body = match?.[1] ?? title
const stop = match?.[2] ?? ''
---

<div class="flex max-w-[52rem] flex-col">
	<h2 data-reveal class="text-[length:var(--text-h2)] leading-[0.94] text-app-text text-balance">
		{body}{stop && <span class="text-[color:var(--band)]">{stop}</span>}
	</h2>

	{lead && (
		<p data-reveal class="mt-(--space-lg) max-w-(--measure) text-[length:var(--text-lead)] leading-[1.5] text-app-text-2 text-pretty">
			{lead}
		</p>
	)}
</div>
