---
interface Props {
	title: string
	lead?: string
}

const { title, lead } = Astro.props

const match = title.match(/^(.*?)([.!?])$/)
const body = match?.[1] ?? title
const stop = match?.[2] ?? ''
---

<div class="flex max-w-208 flex-col">
	<h2 class="text-(length:--text-h2) leading-[0.94] text-app-text text-balance">
		{body}{stop && <span class="text-(--band)">{stop}</span>}
	</h2>

	{lead && (
		<p class="mt-(--space-lg) max-w-(--measure) text-(length:--text-lead) leading-normal text-app-text-2 text-pretty">
			{lead}
		</p>
	)}
</div>
