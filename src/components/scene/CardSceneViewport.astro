---
import { SceneViewport } from './SceneViewport'
import type { SceneNavSlide, SceneTone } from './sceneTheme'

interface Slide {
	id: string
	Component: any
	props?: Record<string, unknown>
	navTone: SceneTone
	// Scenes with little content hug it instead of stretching to a full scene height,
	// which would leave slack below the cards and widen the gap to the next scene.
	hugContent?: boolean
}

const { slides } = Astro.props as { slides: Slide[] }

const navSlides: SceneNavSlide[] = slides.map(({ id, navTone }) => ({ id, navTone }))
---

<SceneViewport client:idle slides={navSlides}>
	{
		slides.map(({ id, Component, props = {}, hugContent }, index) => (
			<section
				class:list={[
					'w-full shrink-0 py-3 md:py-0',
					index === 0 ? 'flex items-center justify-center' : 'md:block',
					index === 0 && 'md:min-h-[calc(100dvh-(var(--page-padding)*2))]',
					index !== 0 && !hugContent && 'md:min-h-(--scene-height)'
				]}
				data-scene-slide={id}
			>
				<Component {...props} />
			</section>
		))
	}
</SceneViewport>
