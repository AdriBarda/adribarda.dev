---
import { render } from 'astro:content'
import type { SectionGroup } from '../../content/sections'
import SectionHead from './SectionHead.astro'

const { group, index = 0 } = Astro.props as { group?: SectionGroup; index?: number }
const entry = group?.entries[0]
const renderedEntry = entry ? await render(entry) : undefined

const languageGroups = (entry?.data.languages ?? []).reduce<Array<{ label: string; details: string[] }>>(
	(groups, item) => {
		const separatorIndex = item.indexOf(':')
		const label = separatorIndex >= 0 ? item.slice(0, separatorIndex).trim() : item.trim()
		const detail = separatorIndex >= 0 ? item.slice(separatorIndex + 1).trim() : ''
		const previous = groups.at(-1)

		if (previous?.label === label && detail) {
			previous.details.push(detail)
			return groups
		}

		groups.push({ label, details: detail ? [detail] : [] })

		return groups
	},
	[]
)

const labelClass = 'text-[length:var(--text-label)] uppercase text-app-muted'
---

<div class="flex w-full flex-col gap-(--space-3xl)">
	<SectionHead title={'Outside work.'} lead={entry?.data.summary} />

	
	<div class="grid gap-(--space-lg) md:grid-cols-[minmax(0,13rem)_minmax(0,1fr)] md:gap-(--space-2xl)">
		<p data-label class={labelClass}>Off the clock</p>
		<div
			class="max-w-(--measure) text-[length:var(--text-body)] leading-[1.78] text-app-muted text-pretty [&_p+p]:mt-(--space-md)"
		>
			{renderedEntry?.Content ? <renderedEntry.Content /> : <p>Missing about body.</p>}
		</div>
	</div>

	{languageGroups.length > 0 && (
		<div class="grid gap-(--space-lg) md:grid-cols-[minmax(0,13rem)_minmax(0,1fr)] md:gap-(--space-2xl)">
			<p data-label class={labelClass}>Languages</p>
			<ul class="flex flex-wrap gap-x-(--space-3xl) gap-y-(--space-lg)">
				{languageGroups.map((languageGroup) => (
					<li class="min-w-[9rem]">
						<p class="text-[length:var(--text-body)] font-medium text-app-text">{languageGroup.label}</p>
						{languageGroup.details.map((detail) => (
							<p class="mt-1 text-[length:var(--text-sm)] leading-[1.6] text-app-muted">{detail}</p>
						))}
					</li>
				))}
			</ul>
		</div>
	)}

	{entry?.data.education && (
		<div class="grid gap-(--space-lg) md:grid-cols-[minmax(0,13rem)_minmax(0,1fr)] md:gap-(--space-2xl)">
			<p data-label class={labelClass}>Education</p>
			<div class="max-w-(--measure)">
				<p class="text-[length:var(--text-lead)] leading-[1.3] font-medium text-app-text">
					{entry.data.education.institution}
				</p>
				<p class="mt-2 text-[length:var(--text-body)] leading-[1.7] text-app-muted text-pretty">{entry.data.education.program}</p>
				<p data-meta class="mt-3 text-[length:var(--text-label)] uppercase text-app-muted">{entry.data.education.period}</p>
			</div>
		</div>
	)}
</div>
