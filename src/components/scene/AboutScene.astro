---
import { render } from 'astro:content'
import type { SectionGroup } from '../../content/sections'
import SectionHead from './SectionHead.astro'

const { group, index = 0 } = Astro.props as { group?: SectionGroup; index?: number }
const entry = group?.entries[0]
const renderedEntry = entry ? await render(entry) : undefined

const languages = entry?.data.languages ?? []
const education = entry?.data.education
---

<div class="flex w-full flex-col gap-(--gap-section)">
	<SectionHead title={entry?.data.title ?? 'Missing about title.'} lead={entry?.data.summary} />

	<div class="about-bento">
		<div data-reveal data-cell="statement" class="about-cell">
			<p data-label class="text-app-muted">Off the clock</p>
			<div class="about-statement">
				{renderedEntry?.Content ? <renderedEntry.Content /> : <p>Missing about body.</p>}
			</div>
		</div>

		{languages.length > 0 && (
			<div data-reveal data-cell="languages" class="about-cell">
				<p data-label class="text-app-muted">Languages</p>
				<ul class="about-langs">
					{languages.map((item) => (
						<li>
							<p class="about-line">
								<span class="text-(length:--text-body) font-medium text-app-text">{item.language}</span>
								<span class="text-(length:--text-body) text-app-muted">{item.level}</span>
							</p>
							{item.note && (
								<p class="mt-1 text-(length:--text-sm) leading-[1.6] text-app-muted text-pretty">{item.note}</p>
							)}
						</li>
					))}
				</ul>
			</div>
		)}

		{education && (
			<div data-reveal data-cell="education" class="about-cell">
				<p data-label class="text-app-muted">Education</p>
				<div>
					<p class="text-(length:--text-body) font-medium text-app-text">{education.institution}</p>
					<p class="mt-1.5 text-(length:--text-sm) leading-[1.65] text-app-muted text-pretty">{education.program}</p>
					<p data-meta class="mt-2.5 text-app-muted">{education.period}</p>
				</div>
			</div>
		)}
	</div>
</div>
