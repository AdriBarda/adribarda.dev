---
import { render } from 'astro:content'
import type { SectionGroup } from '../../content/sections'
import GithubIcon from '../../assets/tech-stack/github.svg'

const { group } = Astro.props as { group?: SectionGroup; index?: number }
const entry = group?.entries[0]
const renderedEntry = entry ? await render(entry) : undefined

const normalizeUrl = (url?: string) =>
	!url ? '#' : url.startsWith('http') ? url : `https://${url}`

const meta = entry?.data.meta ?? []
const details = entry?.data.details ?? []
const github = entry?.data.socials?.github
const linkedin = entry?.data.socials?.linkedin
const title = entry?.data.title ?? 'Missing presentation title.'
const role = entry?.data.role ?? 'Frontend Engineer'
const status = details.find((detail) => detail.label === 'Status')

// Status is the pill and Location is already the meta line beside it — the
// strip carries only what isn't stated elsewhere.
const stripDetails = details.filter(
	(detail) => detail.label !== 'Status' && detail.label !== 'Location'
)

const ghostButton = [
	'inline-flex h-11 items-center justify-center gap-2.5 rounded-[var(--radius-pill)]',
	'border border-app-border px-5 text-[0.94rem] font-medium text-app-text',
	'transition-[background-color,border-color] duration-200 ease-out',
	'hover:border-[var(--band)] hover:text-[var(--band)] active:translate-y-px'
].join(' ')

const labelClass = 'text-[0.7rem] uppercase text-app-muted'
---

{/* One left spine. Checked in a real browser rather than from markup: Alan and
    New Relic both run the hero content hard-left — headline, subhead and CTAs
    stacked tight against the same edge — and centre only the media/container
    around it. The single spine is the part worth keeping from them; nothing
    competes alongside the pitch, and the supporting facts drop to a distinct
    strip at the base so prose never runs next to prose.
    Six direct children — the stagger in global.css cadences on nth-child, so
    this order is the timing. */}
<div class="flex w-full flex-col items-start text-left">
	<div data-hero-part class="flex flex-wrap items-center gap-x-(--space-lg) gap-y-(--space-sm)">
		{status && (
			<span class="inline-flex items-center gap-2.5 rounded-[var(--radius-pill)] border border-app-border bg-app-surface px-4 py-2.5 shadow-[0_0_0_4px_color-mix(in_oklab,var(--band)_10%,transparent)]">
				<span class="relative flex size-2.5 shrink-0 items-center justify-center">
					<span class="absolute inline-flex size-full rounded-full bg-emerald-400/70 animate-ping motion-reduce:hidden"></span>
					<span class="relative inline-flex size-2 rounded-full bg-emerald-500 dark:bg-emerald-400"></span>
				</span>
				<span data-label class="text-[0.7rem] uppercase text-app-text">{status.value}</span>
			</span>
		)}

		{meta.length > 0 && (
			<p data-meta class="text-[length:var(--text-label)] uppercase text-app-muted">{meta.join(' · ')}</p>
		)}
	</div>

	<p data-hero-part class="mt-(--gap-hero) text-[length:var(--text-lead)] leading-[1.3] font-medium text-app-text-2">
		{title}
	</p>

	{/* The marquee still spans the whole shell — centred is not narrow. */}
	<h1
		data-hero-part
		class="mt-(--gap-hero-tight) w-full whitespace-nowrap text-[length:var(--text-hero)] leading-[1.02] font-semibold text-app-text"
	>
		{role}
	</h1>

	<p data-hero-part class="mt-(--gap-hero) max-w-(--measure) text-[length:var(--text-lead)] leading-[1.45] text-app-text-2 text-pretty">
		{entry?.data.summary ?? 'Missing presentation summary.'}
	</p>

	{/* Immediately below the subhead, on the spine — the position all four
	    references give their primary actions. */}
	{(github || linkedin) && (
		<div data-hero-part class="mt-(--gap-hero-cta) flex flex-wrap gap-(--space-sm)">
			{github && (
				<a href={normalizeUrl(github.url)} target="_blank" rel="noopener noreferrer" class={ghostButton}>
					<GithubIcon aria-hidden="true" class="size-4.5 shrink-0 fill-current" />
					<span class="whitespace-nowrap">{github.label}</span>
				</a>
			)}
			{linkedin && (
				<a href={normalizeUrl(linkedin.url)} target="_blank" rel="noopener noreferrer" class={ghostButton}>
					<svg aria-hidden="true" class="size-4.5 shrink-0 fill-current" viewBox="0 0 24 24"><path d="M6.94 8.5H3.56V20h3.38zm.22-3.55C7.16 3.87 6.37 3 5.27 3s-1.89.87-1.89 1.95c0 1.06.77 1.94 1.85 1.94h.02c1.12 0 1.91-.88 1.91-1.94m13.46 8.01c0-3.47-1.81-5.08-4.22-5.08-1.94 0-2.81 1.08-3.29 1.85V8.5H9.73c.04.82 0 11.5 0 11.5h3.38v-6.42c0-.34.02-.68.12-.92.27-.68.88-1.38 1.91-1.38 1.35 0 1.89 1.04 1.89 2.56V20h3.37v-6.04Z"/></svg>
					<span class="whitespace-nowrap">{linkedin.label}</span>
				</a>
			)}
		</div>
	)}

	{/* The proof/stats strip every one of the references lands under its core
	    stack. Smaller, denser, left-read, mono-labelled — a different kind of
	    thing from the pitch, which is why it doesn't compete with it. */}
	<div
		data-hero-part
		class="mt-(--gap-hero-strip) grid w-full gap-(--space-xl) text-left md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)_minmax(0,1fr)] md:gap-(--space-2xl)"
	>
		<div>
			<p data-label class={labelClass}>Background</p>
			<div class="mt-2 text-[length:var(--text-sm)] leading-[1.7] text-app-muted text-pretty [&_p+p]:mt-(--space-sm) [&_strong]:font-semibold [&_strong]:text-app-text">
				{renderedEntry?.Content ? <renderedEntry.Content /> : <p>Missing presentation body.</p>}
			</div>
		</div>

		{stripDetails.map((detail) => (
			<div>
				<p data-label class={labelClass}>{detail.label}</p>
				<p class="mt-2 text-[length:var(--text-sm)] leading-[1.7] text-app-muted text-pretty">
					{detail.url ? (
						<a href={detail.url} target="_blank" rel="noopener noreferrer" class="underline decoration-app-border underline-offset-4 transition-colors hover:decoration-app-text/70">
							{detail.value}
						</a>
					) : (
						detail.value
					)}
				</p>
			</div>
		))}
	</div>
</div>
