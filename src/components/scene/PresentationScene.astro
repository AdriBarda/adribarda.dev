---
import { getCollection, render } from 'astro:content'
import type { SectionGroup } from '../../content/sections'
import GithubIcon from '../../assets/tech-stack/github.svg'
import StarIcon from '@phosphor-icons/core/assets/fill/star-fill.svg'
import SmileIcon from 'lucide-static/icons/smile.svg'
import HeartIcon from 'lucide-static/icons/heart.svg'
import CodeIcon from 'lucide-static/icons/code-xml.svg'

const { group } = Astro.props as { group?: SectionGroup; index?: number }
const entry = group?.entries[0]
const renderedEntry = entry ? await render(entry) : undefined

const sections = await getCollection('sections')
const contribution = sections
	.find((item) => item.data.section === 'open-source')
	?.data.links?.at(0)

const normalizeUrl = (url?: string) =>
	!url ? '#' : url.startsWith('http') ? url : `https://${url}`

const meta = entry?.data.meta ?? []
const details = entry?.data.details ?? []
const github = entry?.data.socials?.github
const linkedin = entry?.data.socials?.linkedin
const title = entry?.data.title ?? 'Missing presentation title.'
const role = entry?.data.role ?? 'Frontend Engineer'
const status = details.find((detail) => detail.label === 'Status')

const ghostButton = [
	'inline-flex h-11 items-center justify-center gap-2.5 rounded-[var(--radius-pill)]',
	'border border-app-border px-5 text-[length:var(--text-sm)] font-medium text-app-text',
	'transition-[background-color,border-color] duration-200 ease-out',
	'hover:border-[var(--band)] hover:text-[var(--band)] active:translate-y-px'
].join(' ')

const labelClass = 'uppercase text-app-muted'
---

<div class="flex w-full flex-col items-start text-left">
	<div class="flex flex-wrap items-center gap-x-(--space-lg) gap-y-(--space-sm)">
		{status && (
			<span class="inline-flex items-center gap-2.5 rounded-(--radius-pill) border border-app-border bg-app-surface px-4 py-2.5 shadow-[0_0_0_4px_color-mix(in_oklab,var(--band)_10%,transparent)]">
				<span class="relative flex size-2.5 shrink-0 items-center justify-center">
					<span class="absolute inline-flex size-full rounded-full bg-emerald-400/70 animate-ping motion-reduce:hidden"></span>
					<span class="relative inline-flex size-2 rounded-full bg-emerald-500 dark:bg-emerald-400"></span>
				</span>
				<span data-label class="uppercase text-app-text">{status.value}</span>
			</span>
		)}

		{meta.length > 0 && (
			<p data-meta class="text-(length:--text-label) uppercase text-app-muted">{meta.join(' · ')}</p>
		)}
	</div>

	<p class="mt-(--gap-hero) text-(length:--text-lead) leading-[1.3] font-medium text-app-text-2">
		{title}
	</p>

	<div class="mt-(--gap-hero-tight) w-full">
		<h1 data-hero-role class="sr-only">{role}</h1>
		<div
			data-hero-role-anim
			aria-hidden="true"
			class="hero-role-anim pointer-events-none w-full whitespace-nowrap text-(length:--text-hero) leading-[1.02] font-semibold text-app-text"
		>
			<span class="hero-word hero-word-front">
				<span class="hero-letter f"><span class="clip"><span>F</span></span></span>
				<span class="hero-letter r"><span class="clip"><span>r</span></span></span>
				<span class="hero-letter o"><span>o</span></span>
				<span class="hero-letter n"><span class="clip"><span><span>n</span><span>#</span></span></span></span>
				<span class="hero-tend">
					<span class="hero-letter t"><span class="clip"><span>t</span></span></span>
					<span class="hero-letter e"><span class="clip"><span>e</span></span></span>
					<span class="hero-letter n2"><span>n</span></span>
					<span class="hero-letter d"><span class="clip"><span>d</span></span></span>
					<span class="hero-icons"><span class="hero-icon"><SmileIcon /></span><span class="hero-icon"><HeartIcon /></span><span class="hero-icon"><CodeIcon /></span></span>
				</span>
			</span><span class="hero-space"> </span><span class="hero-word hero-word-engineer">
				<span class="hero-letter cap-e"><span class="clip"><span><span>E</span><span>3</span></span></span></span>
				<span class="hero-letter n3"><span class="clip"><span>n</span></span></span>
				<span class="hero-letter g"><span>g</span></span>
				<span class="hero-letter i"><span>i</span></span>
				<span class="hero-letter n4"><span class="clip"><span>n</span></span></span>
				<span class="hero-letter e2"><span class="clip"><span>e</span></span></span>
				<span class="hero-letter e3"><span>e</span></span>
				<span class="hero-letter r2"><span class="clip"><span>r</span></span></span>
			</span>
		</div>
	</div>

	<p class="mt-(--gap-hero) max-w-(--measure) text-(length:--text-lead) leading-[1.45] text-app-text-2 text-pretty">
		{entry?.data.summary ?? 'Missing presentation summary.'}
	</p>

	{(github || linkedin) && (
		<div class="mt-(--gap-hero-cta) flex flex-wrap gap-(--space-sm)">
			{github && (
				<a href={normalizeUrl(github.url)} target="_blank" rel="noopener noreferrer" class={ghostButton}>
					<GithubIcon aria-hidden="true" class="size-4.5 shrink-0 fill-current" />
					<span class="whitespace-nowrap">{github.label}</span>
				</a>
			)}
			{linkedin && (
				<a href={normalizeUrl(linkedin.url)} target="_blank" rel="noopener noreferrer" class={ghostButton}>
					<svg aria-hidden="true" class="size-4.5 shrink-0 fill-current" viewBox="0 0 24 24"><path d="M6.94 8.5H3.56V20h3.38zm.22-3.55C7.16 3.87 6.37 3 5.27 3s-1.89.87-1.89 1.95c0 1.06.77 1.94 1.85 1.94h.02c1.12 0 1.91-.88 1.91-1.94m13.46 8.01c0-3.47-1.81-5.08-4.22-5.08-1.94 0-2.81 1.08-3.29 1.85V8.5H9.73c.04.82 0 11.5 0 11.5h3.38v-6.42c0-.34.02-.68.12-.92.27-.68.88-1.38 1.91-1.38 1.35 0 1.89 1.04 1.89 2.56V20h3.37v-6.04Z"/></svg>
					<span class="whitespace-nowrap">{linkedin.label}</span>
				</a>
			)}
		</div>
	)}

	<div
		class="mt-(--gap-hero-strip) grid w-full gap-(--space-xl) text-left md:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] md:gap-(--space-4xl)"
	>
		<div>
			<p data-label class={labelClass}>Background</p>
			<div class="mt-(--space-sm) max-w-[54ch] text-(length:--text-body) leading-[1.7] text-app-text-2 text-pretty [&_p+p]:mt-(--space-sm) [&_strong]:font-semibold [&_strong]:text-app-text">
				{renderedEntry?.Content ? <renderedEntry.Content /> : <p>Missing presentation body.</p>}
			</div>
		</div>

		{contribution && (
			<div class="max-w-[46ch]">
				<p data-label class={labelClass}>Open source</p>

				<a
					href={contribution.repositoryUrl}
					target="_blank"
					rel="noopener noreferrer"
					aria-label={`${contribution.repository} on GitHub, maintained by ${contribution.owner}`}
					class="mt-(--space-sm) inline-flex items-center gap-2.5"
				>
					<GithubIcon aria-hidden="true" class="size-4.5 shrink-0 fill-current text-app-muted" />
					<span class="text-(length:--text-body) font-semibold text-app-text">{contribution.repository}</span>
					{contribution.stars && (
						<span data-meta class="inline-flex items-center gap-1.5 text-app-muted">
							<StarIcon aria-hidden="true" class="size-3 shrink-0 fill-current" />
							{contribution.stars}
						</span>
					)}
				</a>

				<p class="mt-(--space-sm) text-(length:--text-body) leading-[1.7] text-app-text-2 text-pretty">
					{contribution.contribution}
				</p>

				{contribution.pullRequestUrl && (
					<a
						href={contribution.pullRequestUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="mt-(--space-md) inline-block text-(length:--text-sm) font-medium text-app-text underline decoration-app-border underline-offset-4 transition-colors hover:decoration-app-text/70"
					>
						Read the pull request
					</a>
				)}
			</div>
		)}
	</div>
</div>

<script>
	import { gsap, motionOK } from '../../scripts/motion'

	const animatedRole = document.querySelector<HTMLElement>('[data-hero-role-anim]')

	if (animatedRole && motionOK()) {
		const fontsSettled = Promise.race([
			document.fonts?.ready ?? Promise.resolve(),
			new Promise((resolve) => setTimeout(resolve, 1200))
		])

		let context: gsap.Context | undefined
		let cleanedUp = false

		const cleanup = () => {
			cleanedUp = true
			context?.revert()
			window.removeEventListener('astro:before-swap', cleanup)
		}

		window.addEventListener('astro:before-swap', cleanup)

		fontsSettled.then(() => {
			if (cleanedUp) return

			context = gsap.context(() => {
				const select = gsap.utils.selector(animatedRole)
				const letter = (name: string) => select(`.hero-letter.${name}`)
				const glyph = (name: string) => select(`.hero-letter.${name} .clip > span:first-child`)

				const defaults = { duration: 0.6, ease: 'power2.out' }
				const PACE = 1.18

				gsap.set(animatedRole, { autoAlpha: 1 })

				const revealF = () => gsap.timeline({ defaults })
					.set(select('.f .clip'), { transformOrigin: '50% 100%' })
					.from(glyph('f'), { yPercent: 100 })
					.from(select('.f .clip'), {
						rotationX: -180,
						ease: 'back.out(1.7)',
						duration: 1
					}, '-=0.4')

				const slideR = () => gsap.from(glyph('r'), { xPercent: 100, ...defaults })

				const sweepO = () => gsap.from(letter('o'), {
					autoAlpha: 0,
					xPercent: 110,
					yPercent: -100,
					rotationZ: 320,
					scale: 0.6,
					duration: 1.4,
					ease: 'back.out(1.4)'
				})

				const flipN = () => gsap.timeline({ defaults })
					.set(select('.n .clip > span > span:last-child'), { autoAlpha: 1 })
					.from(select('.n .clip > span'), { yPercent: 100, duration: 0.4 })
					.from(select('.n .clip > span > span:first-child'), { rotationY: -180, duration: 0.3 }, '+=0.4')
					.to(select('.n .clip > span > span:last-child'), { rotationY: 180, duration: 0.3 }, '<')

				const iconRun = () => gsap.timeline({ defaults })
					.set(select('.hero-icons'), { autoAlpha: 1 })
					.fromTo(select('.hero-icon'),
						{ xPercent: 205 },
						{ xPercent: -205, duration: 0.95, stagger: 0.3, ease: 'power1.inOut' })
					.to(select('.hero-icon'), {
						keyframes: { scale: [1, 1.32, 1], easeEach: 'sine.inOut' },
						duration: 0.3,
						stagger: 0.3
					}, '<0.325')
					.set(select('.hero-icons'), { autoAlpha: 0 })

				const landT = () => gsap.from(select('.t .clip > span:first-child'),
					{ yPercent: 100, duration: 0.65, ease: 'power2.out' })

				const slideEnd = () => gsap.timeline({ defaults })
					.from(glyph('e'), { yPercent: -100 })
					.from(letter('n2'), { autoAlpha: 0, xPercent: -100 }, '-=0.35')
					.from(glyph('d'), { xPercent: 100 }, '-=0.35')

				const flipCapE = () => gsap.timeline({ defaults })
					.set(select('.cap-e .clip > span > span:last-child'), { autoAlpha: 1 })
					.from(select('.cap-e .clip > span'), { yPercent: 100, duration: 0.4 })
					.from(select('.cap-e .clip > span > span:first-child'), { rotationY: -180, duration: 0.36 }, '+=0.22')
					.to(select('.cap-e .clip > span > span:last-child'), { rotationY: 180, duration: 0.36 }, '<')

				const buildNg = () => gsap.timeline({ defaults })
					.from(glyph('n3'), { xPercent: -100 })
					.from(letter('g'), {
						autoAlpha: 0,
						rotationZ: -120,
						duration: 2,
						ease: 'elastic.out(1, 0.4)'
					}, '-=0.4')

				const spinI = () => gsap.timeline({ defaults })
					.from(select('.i > span'), { autoAlpha: 0, duration: 0.1 })
					.from(select('.i > span'), { rotationX: -450, duration: 1.3 }, '<0.14')
					// Pre-multiplied by PACE so the master timeScale cancels out: the
					// intro speeds up with everything else, the idle loop does not.
					.to(select('.i > span'), {
						rotationX: 360,
						duration: 1.2 * PACE,
						repeat: -1,
						repeatDelay: 4 * PACE,
						ease: 'power2.inOut'
					}, '+=2')

				const finishEngineer = () => gsap.timeline({ defaults })
					.from(glyph('n4'), { yPercent: 100 })
					.from(glyph('e2'), { xPercent: -100 }, '-=0.35')
					.from(letter('e3'), { autoAlpha: 0, scale: 0, duration: 0.9, ease: 'back.out(1.4)' }, '-=0.45')
					.from(glyph('r2'), { xPercent: 100 }, '-=0.5')

				gsap.timeline({ defaults })
					.add(revealF(), 0)
					.add(flipN(), 0.28)
					.add(slideR(), 0.4)
					.add(sweepO(), 0.5)
					.add(iconRun(), 1.25)
					.add(flipCapE(), 1.6)
					.add(buildNg(), 2.05)
					.add(spinI(), 2.6)
					.add(landT(), 2.85)
					.add(slideEnd(), 3.1)
					.add(finishEngineer(), 3.2)
					.timeScale(PACE)
			}, animatedRole)
		})
	}
</script>
