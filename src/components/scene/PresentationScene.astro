---
import { render } from 'astro:content'
import type { SectionGroup } from '../../content/sections'
import GithubIcon from '../../assets/tech-stack/github.svg'
import SmileIcon from 'lucide-static/icons/smile.svg'
import HeartIcon from 'lucide-static/icons/heart.svg'
import CodeIcon from 'lucide-static/icons/code-xml.svg'
import ComponentIcon from 'lucide-static/icons/component.svg'
import DeviceIcon from 'lucide-static/icons/monitor-smartphone.svg'
import GitMergeIcon from 'lucide-static/icons/git-merge.svg'
import FlaskIcon from 'lucide-static/icons/flask-conical.svg'
import JsonIcon from 'lucide-static/icons/file-json.svg'
import DatabaseIcon from 'lucide-static/icons/database.svg'
import WebhookIcon from 'lucide-static/icons/webhook.svg'
import GaugeIcon from 'lucide-static/icons/gauge.svg'

const { group } = Astro.props as { group?: SectionGroup; index?: number }
const entry = group?.entries[0]
const renderedEntry = entry ? await render(entry) : undefined

const normalizeUrl = (url?: string) =>
	!url ? '#' : url.startsWith('http') ? url : `https://${url}`

const meta = entry?.data.meta ?? []
const details = entry?.data.details ?? []
const github = entry?.data.socials?.github
const linkedin = entry?.data.socials?.linkedin
const title = entry?.data.title ?? 'Missing presentation title.'
const role = entry?.data.role ?? 'Software Engineer'
const status = details.find((detail) => detail.label === 'Status')

const ghostButton = [
	'inline-flex h-11 items-center justify-center gap-2.5 rounded-[var(--radius-pill)]',
	'border border-app-border px-5 text-[length:var(--text-sm)] font-medium text-app-text',
	'transition-[background-color,border-color] duration-200 ease-out',
	'hover:border-[var(--band)] hover:text-[var(--band)] active:translate-y-px'
].join(' ')
---

<div class="flex w-full flex-col items-center text-center">
	<div class="flex flex-wrap items-center gap-x-(--space-md) gap-y-(--space-sm) justify-center self-center text-center [--text-label:0.6875rem] md:gap-x-(--space-lg) md:justify-start md:self-end md:text-right md:[--text-label:0.75rem]">
		{status && (
			<span class="inline-flex items-center gap-2 rounded-(--radius-pill) border border-app-border bg-app-surface px-3 py-2 shadow-[0_0_0_4px_color-mix(in_oklab,var(--band)_10%,transparent)] md:gap-2.5 md:px-4 md:py-2.5">
				<span class="relative flex size-2 shrink-0 items-center justify-center md:size-2.5">
					<span class="absolute inline-flex size-full rounded-full bg-emerald-400/70 animate-ping motion-reduce:hidden"></span>
					<span class="relative inline-flex size-1.5 rounded-full bg-emerald-500 md:size-2 dark:bg-emerald-400"></span>
				</span>
				<span data-label class="uppercase text-app-text">{status.value}</span>
			</span>
		)}

		{meta.length > 0 && (
			<p data-meta class="text-(length:--text-label) uppercase text-app-muted">{meta.join(' · ')}</p>
		)}
	</div>

	<p class="mt-10 text-(length:--text-greeting) leading-[1.3] font-medium text-app-text-2 md:mt-(--gap-hero)">
		{title}
	</p>

	<div class="mt-(--gap-hero-tight) w-full">
		<h1 data-hero-role class="sr-only">{role}</h1>
		<div
			data-hero-role-anim
			aria-hidden="true"
			class="hero-role-anim pointer-events-none w-full whitespace-nowrap text-(length:--text-hero) leading-[1.02] font-semibold text-app-text"
		>
			<span class="hero-word hero-word-software">
				<span class="hero-letter s"><span class="clip"><span>S</span></span></span>
				<span class="hero-letter o"><span class="glyph">o</span><span class="hero-icon hero-icon-smile"><SmileIcon /></span></span>
				<span class="hero-letter f"><span class="clip"><span>f</span></span></span>
				<span class="hero-letter t"><span class="clip"><span><span>t</span><span>#</span></span></span></span>
				<span class="hero-letter w"><span class="clip"><span>w</span></span></span>
				<span class="hero-letter a"><span class="clip"><span>a</span></span><span class="hero-icon hero-icon-heart"><HeartIcon /></span></span>
				<span class="hero-letter r"><span class="clip"><span>r</span></span></span>
				<span class="hero-letter e"><span class="clip"><span>e</span></span></span>
				<span class="hero-deco hero-deco-component"><ComponentIcon /></span>
				<span class="hero-deco hero-deco-merge"><GitMergeIcon /></span>
				<span class="hero-deco hero-deco-json"><JsonIcon /></span>
				<span class="hero-deco hero-deco-database"><DatabaseIcon /></span>
			</span><span class="hero-space"> </span><span class="hero-word hero-word-engineer">
				<span class="hero-letter cap-e"><span class="clip"><span><span>E</span><span>3</span></span></span></span>
				<span class="hero-letter n3"><span class="clip"><span>n</span></span></span>
				<span class="hero-letter g"><span>g</span></span>
				<span class="hero-letter i"><span>i</span></span>
				<span class="hero-letter n4"><span class="clip"><span>n</span></span></span>
				<span class="hero-letter e2"><span class="clip"><span>e</span></span></span>
				<span class="hero-letter e3"><span class="glyph">e</span><span class="hero-icon hero-icon-code"><CodeIcon /></span></span>
				<span class="hero-letter r2"><span class="clip"><span>r</span></span></span>
				<span class="hero-deco hero-deco-device"><DeviceIcon /></span>
				<span class="hero-deco hero-deco-flask"><FlaskIcon /></span>
				<span class="hero-deco hero-deco-webhook"><WebhookIcon /></span>
				<span class="hero-deco hero-deco-gauge"><GaugeIcon /></span>
			</span>
		</div>
	</div>

	<p class="mt-(--gap-hero) max-w-(--measure) text-(length:--text-lead) leading-[1.45] text-app-text-2 text-pretty">
		{entry?.data.summary ?? 'Missing presentation summary.'}
	</p>

	{(github || linkedin) && (
		<div class="mt-(--gap-hero-cta) flex flex-wrap justify-center gap-(--space-sm)">
			{github && (
				<a href={normalizeUrl(github.url)} target="_blank" rel="noopener noreferrer" class={ghostButton}>
					<GithubIcon aria-hidden="true" class="size-4.5 shrink-0 fill-current" />
					<span class="whitespace-nowrap">{github.label}</span>
				</a>
			)}
			{linkedin && (
				<a href={normalizeUrl(linkedin.url)} target="_blank" rel="noopener noreferrer" class={ghostButton}>
					<svg aria-hidden="true" class="size-4.5 shrink-0 fill-current" viewBox="0 0 24 24"><path d="M6.94 8.5H3.56V20h3.38zm.22-3.55C7.16 3.87 6.37 3 5.27 3s-1.89.87-1.89 1.95c0 1.06.77 1.94 1.85 1.94h.02c1.12 0 1.91-.88 1.91-1.94m13.46 8.01c0-3.47-1.81-5.08-4.22-5.08-1.94 0-2.81 1.08-3.29 1.85V8.5H9.73c.04.82 0 11.5 0 11.5h3.38v-6.42c0-.34.02-.68.12-.92.27-.68.88-1.38 1.91-1.38 1.35 0 1.89 1.04 1.89 2.56V20h3.37v-6.04Z"/></svg>
					<span class="whitespace-nowrap">{linkedin.label}</span>
				</a>
			)}
		</div>
	)}

	<div class="mt-(--gap-hero-strip) mx-auto w-full max-w-[66rem] text-center text-(length:--text-body) leading-[1.7] text-app-text-2 text-pretty [&_p+p]:mt-(--space-sm) [&_strong]:font-semibold [&_strong]:text-app-text">
		{renderedEntry?.Content ? <renderedEntry.Content /> : <p>Missing presentation body.</p>}
	</div>
</div>

<script>
	import { gsap, motionOK } from '../../scripts/motion'

	const animatedRole = document.querySelector<HTMLElement>('[data-hero-role-anim]')

	if (animatedRole && motionOK()) {
		const fontsSettled = Promise.race([
			document.fonts?.ready ?? Promise.resolve(),
			new Promise((resolve) => setTimeout(resolve, 1200))
		])

		let context: gsap.Context | undefined
		let cleanedUp = false

		let stopPointer: (() => void) | undefined

		const cleanup = () => {
			cleanedUp = true
			stopPointer?.()
			context?.revert()
			window.removeEventListener('astro:before-swap', cleanup)
		}

		window.addEventListener('astro:before-swap', cleanup)

		fontsSettled.then(() => {
			if (cleanedUp) return

			context = gsap.context(() => {
				const select = gsap.utils.selector(animatedRole)
				const letter = (name: string) => select(`.hero-letter.${name}`)
				const glyph = (name: string) => select(`.hero-letter.${name} .clip > span:first-child`)

				const defaults = { duration: 0.85, ease: 'power3.out' }
				const PACE = 0.85

				gsap.set(animatedRole, { autoAlpha: 1 })

				// Icons hold a letter's slot, then hand it over to the real glyph.
				const standIn = (name: string, swapAt: number, enterGlyph: gsap.TweenVars) => {
					const icon = select(`.${name} .hero-icon`)
					const target = select(`.${name} .glyph`).length ? select(`.${name} .glyph`) : glyph(name)

					return gsap.timeline({ defaults })
						.set(icon, { autoAlpha: 1 })
						.from(icon, { scale: 0, yPercent: 90, rotationZ: -120, duration: 0.75, ease: 'back.out(1.6)' })
						.to(icon, {
							keyframes: { scale: [1, 1.28, 1], easeEach: 'sine.inOut' },
							duration: 0.36
						}, '+=0.05')
						.to(icon, { scale: 0, yPercent: -90, rotationZ: 120, duration: 0.32, ease: 'power2.in' }, swapAt)
						.set(icon, { autoAlpha: 0 }, swapAt + 0.32)
						.from(target, enterGlyph, swapAt + 0.18)
				}

				const flipSwap = (name: string) => gsap.timeline({ defaults })
					.set(select(`.${name} .clip > span > span:last-child`), { autoAlpha: 1 })
					.from(select(`.${name} .clip > span`), { yPercent: 100, duration: 0.4 })
					.from(select(`.${name} .clip > span > span:first-child`), { rotationY: -180, duration: 0.32 }, '+=0.3')
					.to(select(`.${name} .clip > span > span:last-child`), { rotationY: 180, duration: 0.32 }, '<')

				const revealS = () => gsap.timeline({ defaults })
					.set(select('.s .clip'), { transformOrigin: '50% 100%' })
					.from(glyph('s'), { yPercent: 100 })
					.from(select('.s .clip'), {
						rotationX: -180,
						ease: 'back.out(1.7)',
						duration: 1
					}, '-=0.4')

				const slide = (name: string, vars: gsap.TweenVars) => gsap.from(glyph(name), { ...defaults, ...vars })

				const buildNg = () => gsap.timeline({ defaults })
					.from(glyph('n3'), { yPercent: 100 })
					.from(letter('g'), {
						autoAlpha: 0,
						yPercent: -70,
						rotationZ: -120,
						duration: 1.6,
						ease: 'elastic.out(1, 0.4)'
					}, '-=0.4')

				const spinI = () => gsap.timeline({ defaults })
					.from(select('.i > span'), { autoAlpha: 0, duration: 0.1 })
					.from(select('.i > span'), { rotationX: -450, duration: 1.2 }, '<0.1')
					// Pre-multiplied by PACE so the master timeScale cancels out: the
					// intro speeds up with everything else, the idle loop does not.
					.to(select('.i > span'), {
						rotationX: 360,
						duration: 1.2 * PACE,
						repeat: -1,
						repeatDelay: 4 * PACE,
						ease: 'power2.inOut'
					}, '+=2')

				// Coding icons scattered around the title: pop in once the letters
				// land, then drift gently forever (durations pre-multiplied by PACE).
				const DECO = [
					{ name: 'component', rotate: -32, sway: 4, drift: 4.6, rise: -5, depth: 46 },
					{ name: 'merge', rotate: 38, sway: -5, drift: 3.8, rise: -9, depth: -28 },
					{ name: 'json', rotate: -9, sway: 6, drift: 3.4, rise: -11, depth: 18 },
					{ name: 'device', rotate: 14, sway: -3, drift: 5, rise: -6, depth: -40 },
					{ name: 'flask', rotate: 27, sway: 6, drift: 4.2, rise: -8, depth: 34 },
					{ name: 'database', rotate: -21, sway: -4, drift: 4.8, rise: -7, depth: -52 },
					{ name: 'webhook', rotate: -44, sway: 7, drift: 3.9, rise: -10, depth: 24 },
					{ name: 'gauge', rotate: 6, sway: -7, drift: 5.4, rise: -6, depth: -36 }
				]

				const scatterDeco = () => {
					const tl = gsap.timeline({ defaults })

					DECO.forEach(({ name, rotate, sway, drift, rise }, index) => {
						const deco = select(`.hero-deco-${name}`)

						tl.set(deco, { autoAlpha: 1, rotationZ: rotate }, index * 0.18)
							.from(deco, {
								scale: 0,
								yPercent: 60,
								rotationZ: rotate - 90,
								duration: 0.9,
								ease: 'back.out(1.5)'
							}, index * 0.18)
							.to(deco, {
								yPercent: rise,
								rotationZ: rotate + sway,
								duration: drift * PACE,
								repeat: -1,
								yoyo: true,
								ease: 'sine.inOut'
							}, index * 0.18 + 0.9)
					})

					return tl
				}

				// Letters cascade left to right; icons hold their slot while the
				// next few letters arrive, then hand over to the real glyph.
				gsap.timeline({ defaults })
					.add(revealS(), 0)
					.add(standIn('o', 1.25, { yPercent: -90, scale: 0.5, autoAlpha: 0, duration: 0.9, ease: 'back.out(1.5)' }), 0.12)
					.add(slide('f', { yPercent: -100 }), 0.24)
					.add(flipSwap('t'), 0.36)
					.add(slide('w', { yPercent: 100 }), 0.5)
					.add(standIn('a', 1.3, { yPercent: -100, ease: 'back.out(1.4)' }), 0.62)
					.add(slide('r', { yPercent: 110, autoAlpha: 0, duration: 0.9, ease: 'back.out(1.4)' }), 0.76)
					.add(slide('e', { yPercent: -100 }), 0.88)
					.add(flipSwap('cap-e'), 1.05)
					.add(buildNg(), 1.18)
					.add(spinI(), 1.42)
					.add(slide('n4', { yPercent: 100 }), 1.55)
					.add(slide('e2', { yPercent: -100 }), 1.67)
					.add(standIn('e3', 1.25, { yPercent: 90, scale: 0.5, autoAlpha: 0, duration: 0.9, ease: 'back.out(1.5)' }), 1.78)
					.add(slide('r2', { yPercent: 100 }), 1.92)
					.add(scatterDeco(), 2.1)
					.timeScale(PACE)

				// Parallax: each icon leans toward (or away from) the cursor by its depth.
				if (window.matchMedia('(pointer: fine)').matches) {
					const movers = DECO.map(({ name, depth }) => ({
						depth,
						x: gsap.quickTo(select(`.hero-deco-${name}`), 'x', { duration: 0.9, ease: 'power3.out' }),
						y: gsap.quickTo(select(`.hero-deco-${name}`), 'y', { duration: 0.9, ease: 'power3.out' })
					}))

					const onPointerMove = (event: PointerEvent) => {
						const dx = event.clientX / window.innerWidth - 0.5
						const dy = event.clientY / window.innerHeight - 0.5

						movers.forEach(({ depth, x, y }) => {
							x(dx * depth)
							y(dy * depth)
						})
					}

					window.addEventListener('pointermove', onPointerMove, { passive: true })
					stopPointer = () => window.removeEventListener('pointermove', onPointerMove)
				}
			}, animatedRole)
		})
	}
</script>
