---
import type { SectionGroup } from '../../content/sections'
import SectionHead from './SectionHead.astro'
import GithubIcon from '../../assets/tech-stack/github.svg'
import StarIcon from '@phosphor-icons/core/assets/fill/star-fill.svg'

const { group, index = 0 } = Astro.props as { group?: SectionGroup; index?: number }
const entry = group?.entries.find((item) => item.data.section === 'open-source')
const links = entry?.data.links ?? []

const labelClass = 'text-[length:var(--text-label)] uppercase text-app-muted'
const linkClass = 'text-[length:var(--text-sm)] font-medium text-app-text underline decoration-app-border underline-offset-4 transition-colors hover:decoration-app-text/70'
---

<div class="flex w-full flex-col gap-(--space-3xl)">
	<SectionHead title={entry?.data.title ?? 'Missing open-source title.'} lead={entry?.data.summary} />

	
	{links.length > 0 ? (
		<div class="flex flex-col gap-(--space-4xl)">
			{links.map((link) => (
				<article
					data-reveal
					class="grid gap-(--space-lg) md:grid-cols-[minmax(0,13rem)_minmax(0,1fr)] md:gap-(--space-2xl)"
				>
					<div class="flex flex-col gap-(--space-sm)">
						<a
							href={link.repositoryUrl}
							target="_blank"
							rel="noopener noreferrer"
							aria-label={`${link.repository} on GitHub, maintained by ${link.owner}`}
							class="inline-flex items-center gap-2.5"
						>
							<GithubIcon aria-hidden="true" class="size-4.5 shrink-0 fill-current text-app-muted" />
							<span class="text-(length:--text-body) font-semibold text-app-text">{link.repository}</span>
						</a>

						<p data-meta class="flex flex-wrap items-center gap-x-3 gap-y-1 text-(length:--text-label) uppercase text-app-muted">
							{link.stars && (
								<span class="inline-flex items-center gap-1.5">
									<StarIcon aria-hidden="true" class="size-3 shrink-0 fill-current" />
									{link.stars}
								</span>
							)}
							{link.language && <span>{link.language}</span>}
							{link.license && <span>{link.license}</span>}
						</p>

						<p class="text-(length:--text-sm) leading-[1.55] text-app-muted">Maintained by {link.owner}</p>
					</div>

					<div class="flex max-w-(--measure) flex-col gap-(--space-lg)">
						<p class="text-(length:--text-lead) leading-normal text-app-text text-pretty">{link.project}</p>

						<div>
							<p data-label class={labelClass}>What I added</p>
							<p class="mt-2 text-(length:--text-body) leading-[1.72] text-app-muted text-pretty">{link.contribution}</p>
						</div>

						{link.reason && (
							<div>
								<p data-label class={labelClass}>Why</p>
								<p class="mt-2 text-(length:--text-body) leading-[1.72] text-app-muted text-pretty">{link.reason}</p>
							</div>
						)}

						<div class="flex flex-wrap items-center gap-x-(--space-lg) gap-y-2">
							<a href={link.pullRequestUrl} target="_blank" rel="noopener noreferrer" class={linkClass}>
								Read the pull request
							</a>
							{link.meta.length > 0 && (
								<p data-meta class="text-(length:--text-label) uppercase text-app-muted">{link.meta.join('  ·  ')}</p>
							)}
						</div>
					</div>
				</article>
			))}
		</div>
	) : (
		<p class="text-(length:--text-body) text-app-muted">Missing open-source contributions.</p>
	)}
</div>
