---
import type { SectionGroup } from '../../content/sections'
import { starsFor } from '../../content/stars'
import SectionHead from './SectionHead.astro'
import GithubIcon from '../../assets/tech-stack/github.svg'
import StarIcon from '@phosphor-icons/core/assets/fill/star-fill.svg'

const { group, index = 0 } = Astro.props as { group?: SectionGroup; index?: number }
const entry = group?.entries.find((item) => item.data.section === 'open-source')

const figuresFor = (link: { additions?: number; deletions?: number; filesChanged?: number; merged?: string }) =>
	[
		link.additions !== undefined && { label: 'Added', value: `+${link.additions}`, tone: 'add' },
		link.deletions !== undefined && { label: 'Removed', value: `−${link.deletions}`, tone: 'cut' },
		link.filesChanged !== undefined && { label: link.filesChanged === 1 ? 'File' : 'Files', value: String(link.filesChanged) },
		link.merged && { label: 'Merged', value: link.merged }
	].filter(Boolean) as { label: string; value: string; tone?: string }[]

const links = await Promise.all(
	(entry?.data.links ?? []).map(async (link) => ({
		...link,
		stars: await starsFor(link.owner, link.repository, link.stars),
		figures: figuresFor(link)
	}))
)

const labelClass = 'text-app-muted'
---

<div class="flex w-full flex-col gap-(--gap-section)">
	<SectionHead title={entry?.data.title ?? 'Missing open-source title.'} lead={entry?.data.summary} />

	{links.length > 0 ? (
		<div class="oss-list">
			{links.map((link) => (
				<article data-reveal class="oss-plate">
					<div class="oss-head">
						<a
							href={link.repositoryUrl}
							target="_blank"
							rel="noopener noreferrer"
							aria-label={`${link.owner}/${link.repository} on GitHub`}
							class="oss-repo"
						>
							<GithubIcon aria-hidden="true" class="size-5 shrink-0 fill-current text-app-muted" />
							<span><span class="text-app-muted">{link.owner}/</span>{link.repository}</span>
						</a>

						{(link.language || link.license) && (
							<p data-meta class="flex flex-wrap items-center gap-x-3 gap-y-1 text-app-muted">
								{link.language && <span>{link.language}</span>}
								{link.license && <span>{link.license}</span>}
							</p>
						)}
					</div>

					<p class="oss-lede max-w-(--measure) text-(length:--text-lead) leading-normal text-app-text text-pretty">
						{link.project}
					</p>

					{(link.stars || link.figures.length > 0) && (
						<dl class="oss-figures">
							{link.stars && (
								<div class="oss-figure">
									<dt data-label class={labelClass}>Stars</dt>
									<dd data-figures class="oss-value">
										<StarIcon aria-hidden="true" class="size-[0.7em] shrink-0 fill-current text-app-muted" />
										{link.stars}
									</dd>
								</div>
							)}

							{link.figures.map((figure) => (
								<div class="oss-figure">
									<dt data-label class={labelClass}>{figure.label}</dt>
									<dd data-figures class="oss-value" data-tone={figure.tone}>{figure.value}</dd>
								</div>
							))}
						</dl>
					)}

					<div class="oss-body">
						<div>
							<p data-label class={labelClass}>What I added</p>
							<p class="mt-2 text-(length:--text-body) leading-[1.72] text-app-text-2 text-pretty">
								{link.contribution}
							</p>
						</div>

						{link.reason && (
							<div>
								<p data-label class={labelClass}>Why</p>
								<p class="mt-2 text-(length:--text-body) leading-[1.72] text-app-text-2 text-pretty">
									{link.reason}
								</p>
							</div>
						)}
					</div>

					<div class="oss-foot">
						<a href={link.pullRequestUrl} target="_blank" rel="noopener noreferrer" class="oss-cta">
							Read the pull request
						</a>
					</div>
				</article>
			))}
		</div>
	) : (
		<p class="text-(length:--text-body) text-app-muted">Missing open-source contributions.</p>
	)}
</div>
