---
import AboutScene from './AboutScene.astro'
import Band from './Band.astro'
import ExperienceScene from './ExperienceScene.astro'
import OpenSourceScene from './OpenSourceScene.astro'
import PresentationScene from './PresentationScene.astro'
import ProjectsScene from './ProjectsScene.astro'
import StackScene from './StackScene.astro'
import SiteNav from '../site/SiteNav.astro'
import type { SectionGroup } from '../../content/sections'

const { sectionGroups } = Astro.props as { sectionGroups: SectionGroup[] }
const groupFor = (scene: number) => sectionGroups.find((group) => group.scene === scene)

const bands = [
	{ id: 'presentation', accent: 1, variant: 'plain', hero: true, Component: PresentationScene, scene: 1 },
	{ id: 'experience', accent: 2, variant: 'paper', Component: ExperienceScene, scene: 2 },
	{ id: 'stack', accent: 3, variant: 'field', Component: StackScene, scene: 3 },
	{ id: 'projects', accent: 4, variant: 'plain', Component: ProjectsScene, scene: 4 },
	{ id: 'open-source', accent: 5, variant: 'paper', Component: OpenSourceScene, scene: 5 },
	{ id: 'about-me', accent: 6, variant: 'plain', Component: AboutScene, scene: 6 }
] as const
---

<SiteNav ids={bands.map(({ id }) => id)} />

{
	bands.map(({ id, accent, variant, hero, Component, scene }, index) => (
		<Band id={id} accent={accent} variant={variant} hero={Boolean(hero)}>
			<Component group={groupFor(scene)} index={index} />
		</Band>
	))
}
