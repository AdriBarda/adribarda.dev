---
import GithubIcon from '../../assets/tech-stack/github.svg'

interface FooterLink { label: string; url: string }

const { footer } = Astro.props as {
	footer?: { location?: string; github?: FooterLink; linkedin?: FooterLink }
}

const normalizeUrl = (url?: string) => (!url ? '#' : url.startsWith('http') ? url : `https://${url}`)
const year = new Date().getFullYear()

const linkClass = [
	'inline-flex items-center gap-2.5 text-[length:var(--text-body)] text-app-muted',
	'transition-colors duration-150 ease-out hover:text-app-text'
].join(' ')

---

<footer class="footer-shell" data-footer-easter-egg>
	<canvas class="footer-confetti-canvas" data-footer-confetti-canvas aria-hidden="true"></canvas>
	<div class="footer-egg-zone" data-footer-egg-zone aria-hidden="true"></div>
	<div class="footer-easter-egg" data-footer-easter-egg-panel>
		<span class="footer-egg-bubble" data-footer-egg-bubble aria-hidden="true"><span data-footer-egg-whisper>psst…</span></span>
		<button type="button" class="footer-red-button" data-footer-red-button aria-label="Do not press">
			<span data-footer-red-label>DO NOT PRESS!</span>
		</button>
	</div>
	<div class="footer-card" data-footer-card>
		<div class="mx-auto w-(--shell)">
			<div class="grid gap-(--space-2xl) lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
				<div>
					<h2 class="max-w-[13ch] text-(length:--text-h2) leading-[0.94] text-app-text text-balance">
						Let&apos;s build something great together<span class="text-(--band)">.</span>
					</h2>
				</div>

				<div class="flex flex-col gap-(--space-lg) lg:items-end lg:text-right">
					{footer?.location && (
						<div>
							<p data-label class="text-app-muted">Located in</p>
							<p class="mt-1.5 text-(length:--text-lead) text-app-text">{footer.location}</p>
						</div>
					)}

					<div class="flex flex-wrap gap-x-(--space-xl) gap-y-2 lg:justify-end">
						{footer?.github && (
							<a href={normalizeUrl(footer.github.url)} target="_blank" rel="noopener noreferrer" class={linkClass}>
								<GithubIcon aria-hidden="true" class="size-4 shrink-0 fill-current" />
								<span>{footer.github.label}</span>
							</a>
						)}
						{footer?.linkedin && (
							<a href={normalizeUrl(footer.linkedin.url)} target="_blank" rel="noopener noreferrer" class={linkClass}>
								<svg aria-hidden="true" class="size-4 shrink-0 fill-current" viewBox="0 0 24 24"><path d="M6.94 8.5H3.56V20h3.38zm.22-3.55C7.16 3.87 6.37 3 5.27 3s-1.89.87-1.89 1.95c0 1.06.77 1.94 1.85 1.94h.02c1.12 0 1.91-.88 1.91-1.94m13.46 8.01c0-3.47-1.81-5.08-4.22-5.08-1.94 0-2.81 1.08-3.29 1.85V8.5H9.73c.04.82 0 11.5 0 11.5h3.38v-6.42c0-.34.02-.68.12-.92.27-.68.88-1.38 1.91-1.38 1.35 0 1.89 1.04 1.89 2.56V20h3.37v-6.04Z"/></svg>
								<span>{footer.linkedin.label}</span>
							</a>
						)}
					</div>

					<p data-meta class="text-app-muted">&copy; {year}. Almost All Rights Reserved.</p>
				</div>
			</div>
		</div>
	</div>
</footer>

<script>
	import { gsap, motionOK } from '../../scripts/motion'
	import { createConfetti, type Confetti } from '../../scripts/confetti'

	const footer = document.querySelector<HTMLElement>('[data-footer-easter-egg]')
	const panel = document.querySelector<HTMLElement>('[data-footer-easter-egg-panel]')
	const zone = document.querySelector<HTMLElement>('[data-footer-egg-zone]')
	const button = document.querySelector<HTMLButtonElement>('[data-footer-red-button]')
	const canvas = document.querySelector<HTMLCanvasElement>('[data-footer-confetti-canvas]')
	const bubble = document.querySelector<HTMLElement>('[data-footer-egg-bubble]')
	const whisperText = bubble?.querySelector<HTMLElement>('[data-footer-egg-whisper]')
	const label = document.querySelector<HTMLElement>('[data-footer-red-label]')

	const eggSupported = window.matchMedia('(hover: hover) and (pointer: fine)').matches && motionOK()

	if (footer && panel && button && canvas && eggSupported) {
		let confetti: Confetti | undefined
		let pending: Promise<Confetti> | undefined

		const load = async (): Promise<Confetti> => {
			const { confettiIcons } = await import('../../scripts/confetti-icons')
			return (confetti ??= createConfetti(canvas, confettiIcons))
		}

		const preload = () => {
			pending ??= load()
		}

		const REST_Y = 68
		const PEEK_Y = 26
		const OPEN_Y = -80
		const HINT_COOLDOWN = 2600
		const AUTO_HINT_EVERY = 7000
		const AUTO_HINT_MAX = 3

		const WHISPERS = ['psst…', 'over here', 'nothing to see', 'don’t.']
		const WARNINGS = ['DO NOT PRESS!', 'STOP.', 'I MEAN IT', 'LAST CHANCE']

		let isOpen = false
		let pressed = false
		let lastHint = 0
		let whisper = 0
		let autoHints = 0
		let autoTimer: number | undefined
		let warnTimer: number | undefined

		gsap.set(panel, { x: 0, y: REST_Y, transformOrigin: '50% 100%' })
		if (bubble) gsap.set(bubble, { autoAlpha: 0, scale: 0.6, transformOrigin: '0% 100%' })

		const setLabel = (text: string) => {
			if (label) label.textContent = text
		}

		// While the button is open and ignored, the warning escalates.
		const startWarnings = () => {
			window.clearInterval(warnTimer)
			let step = 0
			warnTimer = window.setInterval(() => {
				if (pressed || step >= WARNINGS.length - 1) return window.clearInterval(warnTimer)
				step += 1
				setLabel(WARNINGS[step])
				// Wobble the words, not the cap: rotating the cap would swing its 3D edge off the 45° the rest of the panel uses.
				if (label) gsap.fromTo(label, { rotation: -10, scale: 1.25 }, { rotation: 0, scale: 1, duration: 0.6, ease: 'elastic.out(1.2, 0.35)' })
			}, 1400)
		}

		const stopWarnings = () => {
			window.clearInterval(warnTimer)
			if (!pressed) setLabel(WARNINGS[0])
		}

		const fire = async () => {
			pressed = true
			window.clearInterval(warnTimer)
			setLabel('OOPS.')
			window.setTimeout(() => {
				pressed = false
				setLabel(WARNINGS[0])
			}, 2400)
			preload()
			await pending?.then((it) => it.fire())
		}

		const reveal = () => {
			if (isOpen) return
			isOpen = true
			window.clearTimeout(autoTimer)
			if (bubble) gsap.to(bubble, { autoAlpha: 0, scale: 0.6, duration: 0.15, overwrite: true })
			gsap.to(panel, { y: OPEN_Y, rotation: 0, duration: 0.42, ease: 'back.out(1.6)', overwrite: true })
			startWarnings()
		}

		const hide = () => {
			isOpen = false
			stopWarnings()
			gsap.to(panel, { y: REST_Y, rotation: 0, duration: 0.5, ease: 'power3.inOut', overwrite: true })
		}

		// A peek that rattles, as if something is trying to get out, with a whisper.
		const hint = () => {
			const now = window.performance.now()
			if (isOpen || now - lastHint < HINT_COOLDOWN) return
			lastHint = now

			if (whisperText) whisperText.textContent = WHISPERS[whisper++ % WHISPERS.length]

			const tl = gsap
				.timeline()
				.to(panel, { y: PEEK_Y, duration: 0.34, ease: 'back.out(2.2)', overwrite: true })
				.to(panel, {
					keyframes: { rotation: [0, -5, 4, -3, 2, 0] },
					duration: 0.5,
					ease: 'none'
				})
				.to(panel, { y: REST_Y, duration: 0.62, ease: 'power2.inOut' }, '+=0.45')

			if (bubble) {
				tl.to(bubble, { autoAlpha: 1, scale: 1, duration: 0.3, ease: 'back.out(2.4)' }, 0.18)
					.to(bubble, { autoAlpha: 0, scale: 0.6, duration: 0.2, ease: 'power2.in' }, '-=0.7')
			}
		}

		// Nudge on its own once the footer is on screen, a few times at most.
		const scheduleAutoHint = () => {
			window.clearTimeout(autoTimer)
			if (autoHints >= AUTO_HINT_MAX || isOpen) return
			autoTimer = window.setTimeout(() => {
				autoHints += 1
				hint()
				scheduleAutoHint()
			}, autoHints === 0 ? 900 : AUTO_HINT_EVERY)
		}

		new IntersectionObserver(
			([entry]) => (entry.isIntersecting ? scheduleAutoHint() : window.clearTimeout(autoTimer)),
			{ threshold: 0.4 }
		).observe(footer)

		footer.addEventListener('pointerenter', hint)
		footer.addEventListener('pointerenter', preload)
		footer.addEventListener('pointerleave', hide)
		zone?.addEventListener('pointerenter', reveal)
		panel.addEventListener('pointerenter', reveal)
		button.addEventListener('focus', reveal)
		button.addEventListener('focus', preload)
		button.addEventListener('blur', hide)
		button.addEventListener('click', fire)

		window.addEventListener('astro:before-swap', () => confetti?.destroy(), { once: true })
	}
</script>
