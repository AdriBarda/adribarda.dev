---
import GithubIcon from '../../assets/tech-stack/github.svg'

interface FooterLink { label: string; url: string }

const { footer } = Astro.props as {
	footer?: { location?: string; github?: FooterLink; linkedin?: FooterLink }
}

const normalizeUrl = (url?: string) => (!url ? '#' : url.startsWith('http') ? url : `https://${url}`)
const year = new Date().getFullYear()

const linkClass = [
	'inline-flex items-center gap-2.5 text-[length:var(--text-body)] text-app-muted',
	'transition-colors duration-150 ease-out hover:text-app-text'
].join(' ')
---

<footer class="footer-card">
	<div class="mx-auto w-(--shell)">
		<div class="grid gap-(--space-2xl) lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
			<div>
				<h2 class="max-w-[13ch] text-[length:var(--text-h2)] leading-[0.94] text-app-text text-balance">
					Let&apos;s build something great together<span class="text-[color:var(--band)]">.</span>
				</h2>
			</div>

			<div class="flex flex-col gap-(--space-lg) lg:items-end lg:text-right">
				{footer?.location && (
					<div>
						<p data-label class="text-app-muted">Located in</p>
						<p class="mt-1.5 text-[length:var(--text-lead)] text-app-text">{footer.location}</p>
					</div>
				)}

				<div class="flex flex-wrap gap-x-(--space-xl) gap-y-2 lg:justify-end">
					{footer?.github && (
						<a href={normalizeUrl(footer.github.url)} target="_blank" rel="noopener noreferrer" class={linkClass}>
							<GithubIcon aria-hidden="true" class="size-4 shrink-0 fill-current" />
							<span>{footer.github.label}</span>
						</a>
					)}
					{footer?.linkedin && (
						<a href={normalizeUrl(footer.linkedin.url)} target="_blank" rel="noopener noreferrer" class={linkClass}>
							<svg aria-hidden="true" class="size-4 shrink-0 fill-current" viewBox="0 0 24 24"><path d="M6.94 8.5H3.56V20h3.38zm.22-3.55C7.16 3.87 6.37 3 5.27 3s-1.89.87-1.89 1.95c0 1.06.77 1.94 1.85 1.94h.02c1.12 0 1.91-.88 1.91-1.94m13.46 8.01c0-3.47-1.81-5.08-4.22-5.08-1.94 0-2.81 1.08-3.29 1.85V8.5H9.73c.04.82 0 11.5 0 11.5h3.38v-6.42c0-.34.02-.68.12-.92.27-.68.88-1.38 1.91-1.38 1.35 0 1.89 1.04 1.89 2.56V20h3.37v-6.04Z"/></svg>
							<span>{footer.linkedin.label}</span>
						</a>
					)}
				</div>

				<p data-meta class="text-app-muted">&copy; {year}</p>
			</div>
		</div>
	</div>
</footer>

<script>
	import { gsap, motionOK, refreshOnFonts } from '../../scripts/motion'

	// Scrubs the card up over the last section's runway (its padding-bottom).
	const card = document.querySelector<HTMLElement>('.footer-card')
	const last = document.querySelector<HTMLElement>('[data-band]:last-of-type')
	const enabled = window.matchMedia('(min-width: 64rem) and (min-height: 40rem)')

	if (card && last && enabled.matches && motionOK()) {
		// y (px), not yPercent: GSAP layers yPercent on top of the CSS translate3d
		// and leaves the card a full height low.
		gsap.fromTo(
			card,
			{ y: () => card.offsetHeight },
			{
				y: 0,
				ease: 'none',
				scrollTrigger: {
					trigger: last,
					start: () => `bottom bottom+=${card.offsetHeight}`,
					// 'max' = the last scrollable pixel; 'bottom bottom' can resolve
					// past it and park the card short of home.
					end: 'max',
					scrub: true,
					invalidateOnRefresh: true
				}
			}
		)

		refreshOnFonts()
	}
</script>
