---
import Analytics from '@vercel/analytics/astro'
import '../styles/global.css'

const assetBase = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`

const isGithubPagesBuild = import.meta.env.BASE_URL.startsWith('/adribarda.dev')
const robotsContent = isGithubPagesBuild ? 'noindex, nofollow' : 'index, follow'
const siteUrl = 'https://adribarda.dev/'
const pageTitle = 'Adrià Bardají | Frontend Engineer portfolio'
const pageDescription =
	'Adrià Bardají is a Software Engineer focused on building scalable, maintainable web applications and user-centered digital products. Explore my projects, technical skills, and professional experience.'
const socialImageUrl = `${siteUrl}og-image.png`
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Adrià Bardají',
	url: siteUrl,
	jobTitle: 'Frontend Engineer',
	sameAs: ['https://github.com/AdriBarda', 'https://www.linkedin.com/in/adriabardajicros/']
}
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={`${assetBase}favicon.svg`} />
		<meta name="generator" content={Astro.generator} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap"
		/>
		<meta name="description" content={pageDescription} />
		<meta name="robots" content={robotsContent} />
		<link rel="canonical" href={siteUrl} />

		<meta property="og:type" content="website" />
		<meta name="author" content="Adrià Bardají (AdriBarda)">
		<meta property="og:site_name" content="AdriBarda" />
		<meta name="language" content="English">
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:url" content={siteUrl} />
		<meta property="og:image" content={socialImageUrl} />
		<meta property="og:image:type" content="image/png" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />
		<meta name="twitter:image" content={socialImageUrl} />

		<title>{pageTitle}</title>
		<script is:inline src={`${assetBase}theme-init.js`}></script>
		{/* No JS, no attribute, nothing hidden — motion never gates content. */}
		<script is:inline>
			if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
				document.documentElement.dataset.motion = ''
			}
		</script>
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
	</head>
	<body>
		<div class="page">
			<main>
				<slot />
			</main>
		</div>
		<slot name="footer" />
		{!isGithubPagesBuild && <Analytics />}
		<script>
			import { gsap, ScrollTrigger, refreshOnFonts } from '../scripts/motion'

			if (document.documentElement.hasAttribute('data-motion')) {
				const START = 0.75

				// onEnter never fires for elements already past their start (mid-page
				// reload, or a refresh re-resolving starts after webfonts land), and they
				// never cross again — without this they stay at opacity 0 forever.
				const catchUp = () => {
					const missed = Array.from(
						document.querySelectorAll<HTMLElement>('[data-reveal]')
					).filter(
						(el) =>
							Number(gsap.getProperty(el, 'opacity')) < 1 &&
							!gsap.isTweening(el) &&
							el.getBoundingClientRect().top < window.innerHeight * START
					)

					if (missed.length > 0) gsap.set(missed, { y: 0, opacity: 1 })
				}

				// batch() hands over everything crossing the line in one frame, so a row
				// of cards cascades without grouping markup.
				ScrollTrigger.batch('[data-reveal]', {
					start: `top ${START * 100}%`,
					once: true,
					onEnter: (batch) => {
						gsap.to(batch, {
							y: 0,
							opacity: 1,
							duration: 0.7,
							ease: 'power3.out',
							stagger: 0.08,
							overwrite: true
						})

						// Meters ride their tile's entrance rather than owning a trigger.
						const meters = batch.flatMap((el) =>
							Array.from(el.querySelectorAll<HTMLElement>('[data-meter]'))
						)

						if (meters.length > 0) {
							gsap.to(meters, {
								scaleX: 1,
								duration: 0.45,
								ease: 'power2.out',
								stagger: 0.04,
								delay: 0.28,
								overwrite: true
							})
						}
					}
				})

				ScrollTrigger.addEventListener('refresh', catchUp)

				refreshOnFonts()
			}
		</script>
	</body>
</html>

<style>
	html,
	body {
		width: 100%;
	}
</style>
